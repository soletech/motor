#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

require "motor"

module Main
  PROGNAME = "rotor"
  CLIError = Class.new(StandardError)

  Options = Struct.new(:convert, :read, :write, :help, :version)

  class << self
    def call(argv)
      arguments(parser = options(argv, options = Options.new), argv)

      infile, outfile = argv

      options.convert ? convert(infile, outfile, options) : solve(infile, outfile, options)
    rescue CLIError => e # rubocop:disable Lint/RescueException
      warn(parser.help)
      warn("")
      abort(e.message)
    rescue Motor::Error => e
      abort(e.message)
    end

    private

    # rubocop:disable Metrics/MethodLength,Metrics/AbcSize
    def options(argv, options)
      Signal.trap("INT") { Kernel.abort("") }

      OptionParser.new do |option| # rubocop:disable Metrics/BlockLength
        option.banner = <<~BANNER
          Usage: #{PROGNAME} [options...] <INFILE> [<OUTFILE>]

          Options:

        BANNER

        option.on_tail("-c", "--convert", "Convert only") do
          options.convert = true
        end

        option.on("-r", "--read TYPE", "Read type: json, xlsx, default: json", String) do |opt|
          options.read = opt
        end

        option.on("-w", "--write TYPE", "Write type: json, xlsx, default: json", String) do |opt|
          options.write = opt
        end

        option.on_tail("-h", "--help", "Show this message") do
          abort(option.help)
        end

        option.on_tail("-v", "--version", "Show version") do
          warn(Motor::VERSION)
          exit
        end
      end.tap { |parser| parser.parse!(argv) } # rubocop:disable Style/MultilineBlockChain
    end
    # rubocop:enable Metrics/MethodLength,Metrics/AbcSize

    def arguments(parser, argv)
      raise(CLIError, "Too many arguments.") if argv.size > 2
    end

    def convert(infile, outfile, options)
      Motor.convert(
        infile,
        outfile,
        read: options.read,
        write: options.write
      )
    end

    def solve(infile, outfile, options)
      Motor.read_solve_write(
        infile,
        outfile,
        read: options.read,
        write: options.write
      )
    end
  end
end

def main = Main.(ARGV)

main
