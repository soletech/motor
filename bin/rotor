#!/usr/bin/env bash

# TODO: Rewrite in Ruby

BINDIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

die() {
	echo -e "$*" >&2
	exit 1
}

motor() {
	"$BINDIR"/motor "$@"
}

krank() {
	bundle exec "$BINDIR"/krank "$@"
}

main() {
	local reader writer

	while [[ $# -gt 0 ]]; do
		case $1 in
		--)
			shift
			break
			;;
		-r)
			shift
			reader=$1
			;;
		-w)
			shift
			writer=$1
			;;
		-*)
			die "Unrecognized switch: $1"
			;;
		*)
			break
			;;
		esac

		shift
	done

	local infile=$1 outfile=$2

	krank -r "$reader" "$infile" | motor /dev/stdin | krank -r json -w "$writer" /dev/stdin "$outfile"
}

main "$@"
