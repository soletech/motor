{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "type": "object",
  "properties": {
    "objective": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "null",
            "string"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coefficients": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "variables",
        "coefficients"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "rhs": {
            "type": "number",
            "not": {
              "type": "null"
            }
          },
          "relation": {
            "type": "string",
            "minLength": 1,
            "enum": [
              ">",
              ">=",
              "=",
              "<",
              "<="
            ]
          },
          "coefficients": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "constraint",
          "rhs",
          "relation",
          "coefficients"
        ]
      }
    },
    "solution": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "number",
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "value"
          ]
        },
        "sensitivity": {
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "variable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "reduced_cost": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "original_value": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "lower_bound": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "upper_bound": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "is_basic_variable": {
                    "type": "boolean",
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "variable",
                  "value",
                  "reduced_cost",
                  "original_value",
                  "lower_bound",
                  "upper_bound",
                  "is_basic_variable"
                ]
              }
            },
            "boundaries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "constraint": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shadow_price": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "slack_or_surplus": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "original_value": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "lower_bound": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "upper_bound": {
                    "type": "number",
                    "not": {
                      "type": "null"
                    }
                  },
                  "neither_bounds_are_binding": {
                    "type": "boolean",
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "constraint",
                  "shadow_price",
                  "slack_or_surplus",
                  "original_value",
                  "lower_bound",
                  "upper_bound",
                  "neither_bounds_are_binding"
                ]
              }
            }
          },
          "required": [
            "coefficients",
            "boundaries"
          ]
        }
      },
      "required": [
        "result"
      ]
    }
  },
  "required": [
    "objective",
    "constraints"
  ]
}
